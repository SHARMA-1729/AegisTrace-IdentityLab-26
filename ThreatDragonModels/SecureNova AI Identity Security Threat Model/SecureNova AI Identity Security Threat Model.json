{
  "version": "2.6.2",
  "summary": {
    "title": "SecureNova AI Identity Security Threat Model",
    "owner": "Saurav Sharma",
    "description": "SecureNova Inc. operates an AI-powered customer service platform using an LLM-based AI agent integrated with Auth0 for human authentication and authorization. The AI agent communicates with internal REST APIs, retrieves knowledge through a Retrieval-Augmented Generation (RAG) pipeline, and invokes MCP server tools on behalf of authenticated users. The system includes human identities, non-human AI agent identities, OAuth 2.0 machine-to-machine clients, LLM API credentials, RAG service identities, and MCP server identities. This threat model evaluates identity-related attack surfaces, trust boundaries, credential security, privilege escalation, prompt injection, data poisoning, and auditability. Security controls are assessed using STRIDE, OAuth 2.0/OIDC, least privilege, Zero Trust principles, and MITRE ATLAS.",
    "id": 0
  },
